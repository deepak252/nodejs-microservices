{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["ES6"],

    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true,

    "typeRoots": ["./node_modules/@types", "./src/types/types"],

    "moduleResolution": "node"
  },
  "exclude": ["node_modules/"],
  "include": ["./src/**/*", "./src/**/*.json", "global.d.ts"]
}
